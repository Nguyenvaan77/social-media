# Copy this file to .env and choose your own local credentials.
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-password
MEDIA_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
MEDIA_PUBLIC_BASE_URL=http://localhost:8082
AUTH_JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
# JWT claims and lifetimes shared by auth-service and gateway-service.
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=social-media
AUTH_JWT_EXPIRATION=15m
AUTH_JWT_REFRESH_EXPIRATION=168h

# Optional: needed only when running the auth-seed Compose service.
AUTH_SEED_USER_PASSWORD=replace-with-a-user-password-of-at-least-12-characters
AUTH_SEED_ADMIN_PASSWORD=replace-with-an-admin-password-of-at-least-12-characters
AUTH_SEED_ADMIN_GROUP_PASSWORD=replace-with-an-admin-group-password-of-at-least-12-characters
